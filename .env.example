# AIMC 环境变量配置
# 复制此文件为 .env 并填入实际值

# === 服务配置 ===
AIMC_HOST=0.0.0.0
AIMC_PORT=8080
AIMC_LOG_LEVEL=INFO

# === 数据库 ===
AIMC_DB_PATH=./data/aimc.db

# === 网关鉴权（可选，留空则不鉴权）===
AIMC_API_KEY=

# === AI 解析引擎（情报采集层使用）===
# MiniMax token plan 用户：把 base_url 换成 MiniMax 提供的 OpenAI-compatible endpoint
# OPENAI_API_KEY=<your minimax token>
# OPENAI_BASE_URL=https://api.minimax.chat/v1
# AIMC_PARSE_MODEL=minimax-abab6.5s-chat   # 或 gpt-4o-mini（如果 MiniMax 代理了）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AIMC_PARSE_MODEL=gpt-4o-mini

# === Telegram 告警（可选）===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 代理设置（爬虫使用，可选）===
AIMC_PROXY_URL=

# === 渠道 API key（manual_import.py 从这里读，不在代码里写）===
# 至少填一个，不填的渠道会被 import 跳过
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
