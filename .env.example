# AIMC 环境变量配置
# 复制此文件为 .env 并填入实际值

# === 服务配置 ===
AIMC_HOST=0.0.0.0
AIMC_PORT=8080
AIMC_LOG_LEVEL=INFO

# === 加密 (API-Sec-1, 2026-07-29) ===
# 64 字符 hex (32 bytes 原始)
# 生成方法: python scripts/gen_master_key.py
# 务必存到密码管理器, 丢了 = 全部 ciphertext 不可解 = 永久性数据丢失
AIMC_MASTER_KEY=

# === 数据库 ===
AIMC_DB_PATH=./data/aimc.db

# === 网关鉴权（可选，留空则不鉴权）===
AIMC_API_KEY=

# === AI 解析引擎（情报采集层使用）===
# MiniMax token plan 用户：把 base_url 换成 MiniMax 提供的 OpenAI-compatible endpoint
# OPENAI_API_KEY=<your minimax token>
# OPENAI_BASE_URL=https://api.minimax.chat/v1
# AIMC_PARSE_MODEL=minimax-abab6.5s-chat   # 或 gpt-4o-mini（如果 MiniMax 代理了）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AIMC_PARSE_MODEL=gpt-4o-mini

# === 告警通道（默认 log = 只 log，不发任何东西）===
# 国内能用的告警通道（已剔除 Telegram / Discord / Slack 等需要翻墙的工具）：
# 取消下面一行 # 注释 + 配对应 key (BARK_KEY / SERVERCHAN_KEY / FEISHU_WEBHOOK_URL) 即生效
# ALERT_CHANNEL=bark            # iOS Bark（国内首选，需 iPhone）
# ALERT_CHANNEL=serverchan      # Server 酱（推微信，扫码关注公众号）
# ALERT_CHANNEL=feishu          # 飞书自定义机器人 webhook（国内办公首选）
ALERT_CHANNEL=log             # 默认: 只 log, 不真发 (改这一行切换 channel)
# Bark 配置（channel=bark 时生效）
# BARK_KEY=xxxxxxxxxx           # iPhone Bark app 注册设备时给的 key
# BARK_SERVER=                  # 留空用官方 https://api.day.app，或填自建 server
# Server 酱配置（channel=serverchan 时生效）
# SERVERCHAN_KEY=SCTxxxxxxxxxx  # 扫码关注「Server 酱」公众号后获得
# 飞书配置（channel=feishu 时生效）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxx
# Telegram 配置（已废弃，保留字段兼容性，不影响功能）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 代理设置（爬虫使用，可选）===
AIMC_PROXY_URL=

# === 渠道 API key（manual_import.py 从这里读，不在代码里写）===
# V4.4 起多账号迁移到 DB（CLI 优先），.env 转为启动引导。
#
# 三种合法写法（V4.4 都支持）：
# 1) 单 key（最简单，V4.3 兼容）:
#      DEEPSEEK_API_KEY=sk-xxx
# 2) 多 key（同一 provider 多账号，逗号分隔，V4.4 起推荐）:
#      DEEPSEEK_API_KEYS=sk-key1,sk-key2,sk-key3
# 3) DB 优先（key 不填 .env，用 scripts/add_account.py CLI 加账号）:
#      DEEPSEEK_API_KEY=
#      DEEPSEEK_API_KEYS=
#      然后跑:
#        python scripts/add_account.py --channel deepseek --name deepseek_02 --api-key sk-xxx
#
# 至少填一个 provider 的 key，不填的渠道会被 import 跳过。
# 推荐 SILICONFLOW_API_KEY 一码通：1 个 key 调 DeepSeek/Qwen/GLM/Kimi/MiniMax/Doubao/Hunyuan/StepFun/...
#
# 进阶查询/轮换:
#   python scripts/list_accounts.py                 # 列出所有账号（脱敏）
#   python scripts/rotate_account.py rotate --id 5 --new-key sk-new  # 轮换 key

# --- 5 家直连 (国内模型厂商官方平台) ---
DEEPSEEK_API_KEY=   # https://platform.deepseek.com/api_keys
#DEEPSEEK_API_KEYS=sk-key1,sk-key2,sk-key3   # 多 key 用逗号分隔（V4.4 起）
QWEN_API_KEY=       # 阿里云 DashScope https://dashscope.console.aliyun.com/
#QWEN_API_KEYS=sk-key1,sk-key2
GLM_API_KEY=        # 智谱 BigModel https://bigmodel.cn/
#GLM_API_KEYS=glm-key1,glm-key2
KIMI_API_KEY=       # Moonshot https://platform.moonshot.cn/
#KIMI_API_KEYS=sk-key1,sk-key2
# Phase 2D-3: MiniMax OpenAI-compatible 代理 (2026-07-24)
# 留 placeholder — 你填真实 endpoint 后生效
# MINIMAX_API_KEY=<your token>
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=minimax-abab6.5s-chat
MINIMAX_API_KEY=
#MINIMAX_API_KEYS=sk-key1,sk-key2

# --- 1 个第三方聚合 (推荐 1 个 key 通吃) ---
# Phase 2E: 硅基流动 SiliconFlow (2026-07-25) — 1 key 调国内 20+ model
SILICONFLOW_API_KEY=  # https://cloud.siliconflow.cn/account/ak
#SILICONFLOW_API_KEYS=sk-key1,sk-key2

# --- 3 个国内直连官方平台 ---
# Phase 2E: 火山方舟 (字节) (2026-07-25)
VOLCENGINE_API_KEY=   # https://www.volcengine.com/product/ark
#VOLCENGINE_API_KEYS=ak-key1,ak-key2
# Phase 2E: 腾讯混元 (2026-07-25)
HUNYUAN_API_KEY=      # https://cloud.tencent.com/product/hunyuan
#HUNYUAN_API_KEYS=sk-key1,sk-key2
# Phase 2E: 阶跃星辰 (2026-07-25)
STEPFUN_API_KEY=      # https://platform.stepfun.com/
#STEPFUN_API_KEYS=sk-key1,sk-key2

# --- 本地模型服务 (Ollama / vllm / LM Studio / llama.cpp) ---
# 留空用各服务的默认 base_url
# OLLAMA_BASE_URL=http://localhost:11434/v1
# VLLM_BASE_URL=http://localhost:8000/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LLAMACPP_BASE_URL=http://localhost:8080/v1

# === 情报采集总开关（Phase 2D-2, 2026-07-24）===
# true = 启用采集（默认）
# false = 跳过所有采集任务，scheduler 仍注册但 _run_source_task 立即返回
#       试用阶段想看 dashboard 但不想看 retry 日志就关掉
AIMC_CRAWL_ENABLED=true

# === 周报推送（V4.4.B, 2026-08-08）===
# 周报自动复用上面的 AIMC_ALERT_CHANNEL 推送，无额外变量
# 每周一 09:00 (本地时区) systemd timer 自动生成 + 推送
# 周报文件路径: <AIMC_HOME>/reports/weekly-latest.md
# 手动生成: python scripts/generate_weekly_report.py
# 手动推送: python scripts/publish_report.py --channel log    (log = dry-run)
# 查看定时器: systemctl --user list-timers | grep aimc-weekly-report
