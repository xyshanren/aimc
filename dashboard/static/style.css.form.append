/* === P0-UI v6: 加新账号表单 + 账号管理列样式 === */

.accounts-form {
    padding: var(--space-md);
    background: var(--bg-elevated);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-muted);
}

.accounts-form .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
    align-items: start;
}

.accounts-form .form-row:last-of-type {
    margin-bottom: 0;
}

.accounts-form label {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-size: 11px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.3px;
    font-weight: 500;
}

.accounts-form input,
.accounts-form select {
    padding: 6px var(--space-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 13px;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.15s ease;
}

.accounts-form input:focus,
.accounts-form select:focus {
    border-color: var(--color-info);
    box-shadow: var(--shadow-glow);
}

.accounts-form input[type="password"] {
    font-family: var(--font-mono);
    letter-spacing: 1px;
}

.accounts-form .form-row > button {
    align-self: end;
}

.accounts-form .feedback {
    font-size: 12px;
    margin-left: var(--space-md);
}

.accounts-form .feedback.success { color: var(--color-success); }
.accounts-form .feedback.error { color: var(--color-danger); }

/* 单独一行的 label (api_key, notes) */
.accounts-form .form-row.single {
    grid-template-columns: 1fr;
}

/* 表格内 column header 颜色更柔和 */
.accounts-form table thead th {
    color: var(--text-secondary);
    font-weight: 500;
}

/* 已用/总额 列宽固定 */
.accounts-form th:nth-child(4),
.accounts-form th:nth-child(5),
.accounts-form td:nth-child(4),
.accounts-form td:nth-child(5) {
    text-align: right;
    font-family: var(--font-mono);
    font-size: 12px;
}

/* 账号管理 toolbar 优化 */
.accounts-toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
}

.accounts-toolbar .meta {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 12px;
}