# AIMC .env 模板 (Phase 4 v4.3)
# 用法: cp env.template .env, 然后填实际值

# === 服务配置 ===
AIMC_HOST=0.0.0.0
AIMC_PORT=8080
AIMC_LOG_LEVEL=INFO

# === 加密 (API-Sec-1) ===
# 必须先生成: python scripts/gen_master_key.py
# 64 字符 hex (32 bytes), 务必存到密码管理器
# 丢失 = 所有 ciphertext 永久不可解
AIMC_MASTER_KEY=

# === 数据库 ===
AIMC_DB_PATH=./data/aimc.db

# === 网关鉴权 (可选, 留空则不鉴权) ===
# 多客户端接入时建议设一个, 防止 LAN 内被滥用
AIMC_API_KEY=

# === AI 解析引擎 (情报采集层使用) ===
# MiniMax token plan (1 年) 用法:
#   OPENAI_API_KEY=<你的 minimax token>
#   OPENAI_BASE_URL=https://api.minimax.chat/v1
#   AIMC_PARSE_MODEL=minimax-abab6.5s-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AIMC_PARSE_MODEL=gpt-4o-mini

# === 告警通道 (默认 log, 不发任何东西) ===
AIMC_ALERT_CHANNEL=log
# Bark (iOS) 示例: AIMC_ALERT_CHANNEL=bark, AIMC_BARK_KEY=xxx
# 飞书 webhook 示例: AIMC_ALERT_CHANNEL=feishu, AIMC_FEISHU_WEBHOOK_URL=https://open.feishu.cn/...
AIMC_BARK_KEY=
AIMC_FEISHU_WEBHOOK_URL=

# === 9 厂商 API key (Phase 2E + Phase 3.6) ===
# v4.3 部署验证: 至少填 5 个已开通 key 的厂商

# 1. deepseek (按量付费) — 主路由
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 2. qwen (阿里百炼 DashScope) — OpenAI 兼容
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 3. glm (智谱) — OpenAI 兼容
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 4. kimi (月之暗面 Moonshot) — OpenAI 兼容
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 5. MiniMax (1 年 token plan) — 用于 AI 解析 + 兜底
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# 6. siliconflow (硅基流动, 第三方聚合)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 7. volcengine (字节方舟) — 按量付费
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 8. hunyuan (腾讯混元) — v4.3 未开通, 留空
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.tencent.com/v1

# 9. stepfun (阶跃星辰, 1 月 token plan)
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1

# === 代理 (可选, 爬虫用) ===
AIMC_PROXY_URL=

# === 路由/采集参数 (一般不需要改) ===
AIMC_ROUTE_REFRESH_INTERVAL=300
AIMC_MAX_FALLBACK_RETRIES=2
AIMC_REQUEST_TIMEOUT=120.0
AIMC_CRAWL_INTERVAL=900
AIMC_DIFF_SIMILARITY_THRESHOLD=0.9
AIMC_PARSE_CONFIDENCE_THRESHOLD=0.8
AIMC_CRAWL_ENABLED=true
AIMC_PRICE_ALERT_THRESHOLD_PCT=30.0

# === 周报推送（V4.4.B, 2026-08-08）===
# 周报复用上面的 AIMC_ALERT_CHANNEL 推送，无额外变量
# 每周一 09:00 本地时区 systemd timer 自动生成 + 推送
# 输出: <AIMC_HOME>/reports/weekly-latest.md (gitignore)
# 手动生成: python scripts/generate_weekly_report.py
# 手动推送: python scripts/publish_report.py --channel log   (log = dry-run)
# 查看定时器: systemctl --user list-timers | grep aimc-weekly-report