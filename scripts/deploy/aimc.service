[Unit]
Description=AIMC - AI Model Compass Gateway (user instance)
Documentation=https://github.com/<your-repo>
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/aimc
Environment="PATH=%h/aimc/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=%h/aimc/.env

# V4.8.4: 启动前清理上次崩溃残留的孤儿 chrome 进程 (防内存泄漏累积)
# 注意: pkill -f 会匹配自身命令行导致自杀, 用 chrome 的进程名 (非完整路径) 避开
# Playwright headless chrome 进程名含 "chrome" 但不含 "pkill"
ExecStartPre=/bin/bash -c 'pids=$(pgrep -f "[c]hrome-linux64/chrome" 2>/dev/null); [ -n "$pids" ] && kill $pids 2>/dev/null; true'

ExecStart=%h/aimc/.venv/bin/python main.py
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# V4.8.4: 停止时给 30s 优雅退出 (等待 in-flight fetch + close_browser), 超时 systemd 发 SIGKILL
TimeoutStopSec=30
# V4.8.4: 杀整个 cgroup (含 playwright driver 子进程), 不留孤儿
KillMode=control-group

# 日志走 journald (journalctl --user -u aimc)
StandardOutput=journal
StandardError=journal

# 资源限制 (AIMC 轻量, 给些余量)
LimitNOFILE=65536
MemoryMax=2G

# 安全 (Phase 4 v4.3 加, 但保持简单)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
# 注意: ProtectHome=read-only 会让 ~/aimc 写入失败 — 用 ReadWritePaths 显式放行
ReadWritePaths=%h/aimc/data %h/aimc/.venv

[Install]
WantedBy=default.target