#!/usr/bin/env python
"""Pre-commit hook: 阻止 .env 任何变体被 commit (Phase 2E, 2026-07-25)

检查 git staged files, 如果有 .env / .env.* / .env.local / etc. → 拒绝 commit.

安装方法 (只需 1 次, 之后 git hook 自动生效):
    git config core.hooksPath .githooks

或者 Windows PowerShell:
    git config core.hooksPath .githooks
"""
import subprocess
import sys

# 不能 commit 的文件模式
FORBIDDEN_PATTERNS = (
    ".env",
    ".env.local",
    ".env.production",
    ".env.development",
    ".env.*.local",
    # 注意: .env.example 允许 (在白名单)
)

ALLOWED = {".env.example", ".env.sample", ".env.template"}


def main() -> int:
    # 用 git diff --cached --name-only 拿 staged 文件
    try:
        result = subprocess.run(
            ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
            capture_output=True, text=True, check=True, encoding="utf-8",
        )
    except subprocess.CalledProcessError as e:
        print(f"[pre-commit] FAIL: git diff error: {e}")
        return 1

    staged_files = [f.strip() for f in result.stdout.splitlines() if f.strip()]
    violations = []

    for filepath in staged_files:
        # 跳过允许的白名单
        basename = filepath.replace("\\", "/").split("/")[-1]
        if basename in ALLOWED:
            continue

        # 检查 forbidden patterns
        for pattern in FORBIDDEN_PATTERNS:
            if filepath == pattern or filepath.endswith("/" + pattern):
                violations.append((filepath, pattern))
                break

    if violations:
        print("[pre-commit] FAIL: 检测到敏感文件, 拒绝 commit:\n")
        for filepath, pattern in violations:
            print(f"  - {filepath}  (匹配 pattern: {pattern})")
        print(f"\n如确实要 commit 这些文件, 请:")
        print(f"  1. 确认它们真的不包含真实 API key")
        print(f"  2. 用 git commit --no-verify 跳过 hook (不推荐)")
        print(f"  3. 或者从 .gitignore 移除对应 pattern")
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
