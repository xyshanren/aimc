#!/usr/bin/env python
"""Pre-commit hook (Phase 2E, 2026-07-25 + Phase 4 v4.3, 2026-08-13)

检查 2 项:
1. 阻止 .env 任何变体被 commit (防泄露 API Key)
2. model_registry / model_groups 修改时, 触发 db 一致性检测
   (防 family 大写 / model_id namespace 错误 / model 漂移)

安装方法 (只需 1 次, 之后 git hook 自动生效):
    git config core.hooksPath .githooks

或者 Windows PowerShell:
    git config core.hooksPath .githooks
"""
import subprocess
import sys

# 不能 commit 的文件模式
FORBIDDEN_PATTERNS = (
    ".env",
    ".env.local",
    ".env.production",
    ".env.development",
    ".env.*.local",
    # 注意: .env.example 允许 (在白名单)
)

ALLOWED = {".env.example", ".env.sample", ".env.template"}


def main() -> int:
    # 用 git diff --cached --name-only 拿 staged 文件
    try:
        result = subprocess.run(
            ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
            capture_output=True, text=True, check=True, encoding="utf-8",
        )
    except subprocess.CalledProcessError as e:
        print(f"[pre-commit] FAIL: git diff error: {e}")
        return 1

    staged_files = [f.strip() for f in result.stdout.splitlines() if f.strip()]
    violations = []

    for filepath in staged_files:
        # 跳过允许的白名单
        basename = filepath.replace("\\", "/").split("/")[-1]
        if basename in ALLOWED:
            continue

        # 检查 forbidden patterns
        for pattern in FORBIDDEN_PATTERNS:
            if filepath == pattern or filepath.endswith("/" + pattern):
                violations.append((filepath, pattern))
                break

    if violations:
        print("[pre-commit] FAIL: 检测到敏感文件, 拒绝 commit:\n")
        for filepath, pattern in violations:
            print(f"  - {filepath}  (匹配 pattern: {pattern})")
        print(f"\n如确实要 commit 这些文件, 请:")
        print(f"  1. 确认它们真的不包含真实 API key")
        print(f"  2. 用 git commit --no-verify 跳过 hook (不推荐)")
        print(f"  3. 或者从 .gitignore 移除对应 pattern")
        return 1

    # === Phase 4 v4.3 (2026-08-13): model registry 一致性检测 ===
    # 仅在 seed_* / db/crud.py / model 字段相关文件修改时触发
    MODEL_TRIGGER_FILES = (
        "scripts/seed_model_registry.py",
        "scripts/seed_model_groups.py",
        "scripts/seed_model_cards.py",
        "db/normalizers.py",
        "db/crud.py",
        "db/models.py",
    )
    model_triggered = any(
        any(f.endswith(trigger) for trigger in MODEL_TRIGGER_FILES)
        for f in staged_files
    )
    if model_triggered:
        print("[pre-commit] 检测到 model 相关文件修改, 跑 db 一致性检查...")
        try:
            result = subprocess.run(
                ["python", "scripts/check_model_consistency.py", "--check", "db"],
                capture_output=True, text=True, timeout=60,
            )
        except subprocess.TimeoutExpired:
            print("[pre-commit] FAIL: model 检查超时 (> 60s)")
            return 1
        except Exception as e:
            print(f"[pre-commit] FAIL: model 检查异常: {e}")
            return 1

        if result.returncode == 2:
            print("[pre-commit] FAIL: model 检查发现 ERROR:")
            print(result.stdout)
            print(result.stderr)
            return 1
        elif result.returncode == 1:
            print("[pre-commit] WARN: model 检查 WARN:")
            print(result.stdout)
        else:
            print(f"[pre-commit] OK: model 检查通过")

    # === Phase 4 v4.3.1 (2026-08-13): group_members 一致性检测 ===
    GROUP_TRIGGER_FILES = (
        "scripts/seed_model_groups.py",
        "scripts/check_group_members_consistency.py",
    )
    group_triggered = any(
        any(f.endswith(trigger) for trigger in GROUP_TRIGGER_FILES)
        for f in staged_files
    )
    if group_triggered:
        print("[pre-commit] 检测到 group 相关文件修改, 跑 group_members 一致性检查...")
        try:
            result = subprocess.run(
                ["python", "scripts/check_group_members_consistency.py"],
                capture_output=True, text=True, timeout=60,
            )
        except subprocess.TimeoutExpired:
            print("[pre-commit] FAIL: group_members 检查超时 (> 60s)")
            return 1
        except Exception as e:
            print(f"[pre-commit] FAIL: group_members 检查异常: {e}")
            return 1

        if result.returncode == 2:
            print("[pre-commit] FAIL: group_members 检查发现 ERROR:")
            print(result.stdout)
            print(result.stderr)
            return 1
        elif result.returncode == 1:
            print("[pre-commit] WARN: group_members 检查 WARN:")
            print(result.stdout)
        else:
            print(f"[pre-commit] OK: group_members 检查通过")

    return 0


if __name__ == "__main__":
    sys.exit(main())
